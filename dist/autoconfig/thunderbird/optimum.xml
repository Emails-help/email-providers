<?xml version='1.0' encoding='utf-8'?>
<clientConfig version="1.1">
  <!-- Emails.help dataset version 1 -->
  <emailProvider id="optimum.net">
    <domain>optimum.net</domain>
    <displayName>Optimum Email</displayName>
    <displayShortName>Optimum Email</displayShortName>
    <incomingServer type="imap">
      <hostname>mail.optimum.net</hostname>
      <port>993</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </incomingServer>
    <incomingServer type="pop3">
      <hostname>mail.optimum.net</hostname>
      <port>995</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>mail.optimum.net</hostname>
      <port>465</port>
      <socketType>SSL</socketType>
      <username>%EMAILADDRESS%</username>
      <authentication>password-cleartext</authentication>
    </outgoingServer>
  </emailProvider>
</clientConfig>
